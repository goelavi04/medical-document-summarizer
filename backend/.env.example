# Copy to .env and fill in. Never commit the real .env.

# Where the trained LoRA adapter lives: a local directory (e.g. models/adapter) or a
# Hugging Face Hub repo id (e.g. yourname/phi3-mini-pubmed-qlora-adapter).
ADAPTER_PATH=models/adapter

# Patient Explainer Agent — needs at least one of these to actually produce output.
# Get a free Groq API key at https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# Fallback if GROQ_API_KEY is unset or the Groq call fails. Requires a local Ollama
# install (https://ollama.com) with the model pulled: `ollama pull llama3.2`.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Verification thresholds
VERIFICATION_COVERAGE_THRESHOLD=0.5
MAX_REGENERATION_ATTEMPTS=1
